# Copy to .env for local runs:  cp .env.example .env

# --- required ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- models (any OpenRouter model that supports tool calling) ---
ROOT_MODEL=openrouter/openai/gpt-4o-mini
SPECIALIST_MODEL=openrouter/openai/gpt-4o-mini
# e.g. openrouter/anthropic/claude-sonnet-4.5, openrouter/google/gemini-2.5-flash,
#      openrouter/meta-llama/llama-3.3-70b-instruct

# --- app ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
# Leave empty locally. Set on Cloud Run to require an X-API-Key header.
APP_API_KEY=

# --- storage (defaults: ./data/retail.db and ./data/sessions.db) ---
# SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
# SESSION_DB_URL=postgresql+asyncpg://user:pass@host:5432/sessions   # production multi-instance
# RETAIL_DB_PATH=./data/retail.db

# --- business rules ---
REFUND_AUTO_APPROVE_LIMIT=500
RETURN_WINDOW_DAYS=30
